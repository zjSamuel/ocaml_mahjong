# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "An OCaml japanese mahjong engine and AI assistant in Ocaml"
description:
  "A Riichi Mahjong game engine with A*-based shanten/efficiency analysis and multi-level bot AI."
maintainer: ["hxxlyhjh@gmail.com" "jzhou171@jh.edu"]
authors: ["Zeli Ma" "Jin Zhou" "Jiewen Luo"]
depends: [
  "dune" {>= "3.20"}
  "ounit2" {>= "2.2.7"}
  "core" {>= "0.17.1"}
  "dream" {>= "1.0.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
